#!/bin/sh
# Build the user intermediate library and both CarbonTransfer solvers.
set -eu
cd "$(dirname "$0")"
: "${FOAM_USER_LIBBIN:?Please load OpenFOAM.com v2312 first}"
: "${FOAM_USER_APPBIN:?Please load OpenFOAM.com v2312 first}"
mkdir -p "$FOAM_USER_LIBBIN" "$FOAM_USER_APPBIN"
echo '=== 1/2: user liblagrangianIntermediate ==='
(cd src/lagrangian/intermediate && wmake libso)
echo '=== 2/2: reactingParcelFoamCarbonTransfer ==='
(cd applications/solvers/lagrangian/reactingParcelFoamCarbonTransfer && wmake)
echo '=== Checking the dynamically linked intermediate library ==='
for solver in reactingParcelFoamCarbonTransfer
do
    ldd "$FOAM_USER_APPBIN/$solver" | grep liblagrangianIntermediate || true
done
