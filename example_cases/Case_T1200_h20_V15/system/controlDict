FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     reactingParcelFoamCarbonTransfer; // Custom reacting parcel solver

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20;

deltaT          0.0001; // Fixed time step (s)

writeControl    adjustable;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

adjustTimeStep  no; // Keep the injection schedule aligned with the time step

maxCo           0.25;

maxDeltaT       0.001;

runTimeModifiable yes;

functions
{

    moleFractions1
    {
        type            rhoReactionThermoMoleFractions;
        libs            (fieldFunctionObjects);
    }

    fieldAverage1
    {
        type            fieldAverage;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
        timeStart       10;

        fields
        (
            U
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            T
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            rho
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            p
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            CH4
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

            H2
            {
                mean        on;
                prime2Mean  off;
                base        time;
            }

        );
    }

}


