FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 9.74e-6;

boundaryField
{

    "(inlet)"
    {
        type            fixedValue;
        value           $internalField;
    }

    "(outlet)"
    {
        type            inletOutlet;
        phi             phi;
        inletValue      $internalField;
        value           $internalField;
    }

    tubeWall
    {
        type            kqRWallFunction;
        value           uniform 9.74e-6;
    }
}


