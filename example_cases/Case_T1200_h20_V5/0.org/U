FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ************************************************************************* //

dimensions          [0 1 -1 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    inlet
    {
        type                flowRateInletVelocity;
        // Inlet flow rate: 5 L/min (0.3 m3/h).
        volumetricFlowRate  constant 8.33333333333333e-05;
    }

    outlet
    {
        type                pressureInletOutletVelocity;
        phi                 phi;
        value               uniform (0 0 0);
    }

    tubeWall
    {
        type                fixedValue;
        value               uniform (0 0 0);
    }
}

