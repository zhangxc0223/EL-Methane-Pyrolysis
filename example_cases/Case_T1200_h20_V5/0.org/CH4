FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      CH4;
}
// ************************************************************************* //

dimensions          [0 0 0 0 0 0 0];

internalField       uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1; 
    }

    outlet
    {
        type                zeroGradient;

    }

    tubeWall
    {
        type                zeroGradient;
    }
}

