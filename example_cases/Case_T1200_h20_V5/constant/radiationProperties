FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation       on;

radiationModel  fvDOM;

fvDOMCoeffs
{
    nPhi        3;
    nTheta      5;
    maxIter     10;
    tolerance   1e-3;
}

solverFreq 10;

// Combine gas radiation with radiation from carbon parcels.
absorptionEmissionModel binaryAbsorptionEmission;

binaryAbsorptionEmissionCoeffs
{
    // Gas absorption and emission.
    model1
    {
        absorptionEmissionModel constantAbsorptionEmission;
        constantAbsorptionEmissionCoeffs
        {
            absorptivity    absorptivity    [0 -1 0 0 0 0 0] 0.1;
            emissivity      emissivity      [0 -1 0 0 0 0 0] 0.1;
            E               E   [1 -1 -3 0 0 0 0] 0;
        }
    }
    // Particle absorption and emission from reactingCloud1.
    model2
    {
        absorptionEmissionModel cloudAbsorptionEmission;
        cloudAbsorptionEmissionCoeffs
        {
            cloudNames
            (
                reactingCloud1
            );
        }
    }
}

scatterModel    none;

cloudScatterCoeffs
{
    cloudNames
    (
                reactingCloud1
    );
}

transmissivityModel none;

